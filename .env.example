# Postgres connection used by the CLI, the API and the migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/can_i_apply

# Separate database used by the integration tests. Never point this at a database you care about:
# the test setup truncates every table before each run.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/can_i_apply_test

# Only needed when running normalisation against the live Anthropic API.
# The test suite never reads this: it uses recorded fixtures instead.
ANTHROPIC_API_KEY=

# Model used for location normalisation.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Port for the HTTP API.
PORT=3000
